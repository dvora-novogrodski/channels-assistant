# Copy to .env and fill in. Never commit .env.

# --- LLM (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# "-latest" aliases track Google's current free-tier models, so they don't go stale.
LLM_MODEL=gemini-flash-lite-latest
# Tried once when the main model is rate-limited (429) or overloaded (5xx). Leave empty to disable.
LLM_FALLBACK_MODEL=gemini-flash-latest

# --- Slack (Socket Mode, so no public URL is needed for the bot) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# --- Server ---
PORT=3000
# When true, sending "simulate failure" triggers a fake LLM outage (for the demo video).
DEMO_FAILURES=false
