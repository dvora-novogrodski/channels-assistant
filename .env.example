# Copy to .env and fill in. Never commit .env.

# --- LLM (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Free-tier model names change; check AI Studio for the current list.
LLM_MODEL=gemini-2.5-flash
# Used once when the main model is rate-limited (429). Leave empty to disable.
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- Slack (Socket Mode, so no public URL is needed for the bot) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# --- Server ---
PORT=3000
# When true, sending "simulate failure" triggers a fake LLM outage (for the demo video).
DEMO_FAILURES=false
